#!/bin/sh
# Mirrors scripts/run-ensemble, but for the ad hoc Experiment A/B and
# representative-member runs in analysis/channel2/experiments/experiment-design.csv
# instead of the 100-member drawn ensemble.
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "Usage: ./analysis/channel2/run-experiment RUN_ID [RUN_DIR]" >&2
  exit 2
fi

run_id=$1
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
run_dir=${2:-$repo_dir/runs/experiments/$run_id}
if [ -e "$run_dir" ]; then
  echo "Run directory already exists: $run_dir" >&2
  exit 2
fi

Rscript "$here/prepare-experiment.R" "$run_id" "$run_dir"
Rscript "$here/verify-experiment.R" "$run_id" "$run_dir"
cd "$run_dir"
MODEL_ID=S0.90-F2 PROGRAM_PATH=${PROGRAM_PATH:-./mfclo64} ./doitall.sh
cp 11.par final.par
Rscript "$here/verify-experiment.R" "$run_id" "$run_dir"
echo "Completed $run_id: $run_dir/final.par"
